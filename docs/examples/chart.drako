MyChart: Chart {
  width: 800
  height: 400
  x: [jan, feb, mar, apr, may, jun, jul, aug, sep, oct, nov, dec]
  y: 4000 -> 11000
  title: "Sales Revenue"
  xLabel: "Months"
  yLabel: "Revenue (in $)"

  MyBarChart: Bar {
    values: [5000, 6000, 7500, 8200, 9500, 10500, 11000, 10200, 9200, 8500, 7000, 6000]
    color: #1d4ed8
    is3D: true
  }

  MyLineChart: Line {
    values: [5500, 6000, 7500, 8200, 9500, 10500, 11000, 10200, 9200, 8500, 7000, 6000]
    color: #00ff00
    filled: false
  }
}
