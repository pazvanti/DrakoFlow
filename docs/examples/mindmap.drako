  label: "British popular psychology\nauthor Tony Buzan"
}

// Research branch (purple)
mindmap -> Research
Research -> AutoCreation
AutoCreation -> Uses
Uses -> StrategicPlanning
Uses -> CreativeTech
Uses -> ArgumentMapping
Research -> Effectiveness

// Tools branch (cyan)
mindmap -> Tools
Tools -> PenPaper
Tools -> Mermaid

// Origins branch (amber/rust)
mindmap -> Origins
Origins -> Popularisation
Popularisation -> TonyBuzan
Origins -> History
