{
  "name": "drakoflow-vscode",
  "displayName": "DrakoFlow Diagram Engine",
  "description": "Fast, privacy-first text-to-diagram engine with live preview, bi-directional code highlighting, Git Flow, sequence flows, and architecture diagrams.",
  "version": "1.0.0",
  "publisher": "pazvanti",
  "icon": "icon.png",
  "homepage": "https://pazvanti.github.io/DrakoFlow/",
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/pazvanti/DrakoFlow/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pazvanti/DrakoFlow.git",
    "directory": "vscode-extension"
  },
  "keywords": [
    "diagram",
    "diagrams",
    "text-to-diagram",
    "diagram-preview",
    "sequence-diagram",
    "flowchart",
    "architecture",
    "software-architecture",
    "git-flow",
    "gitgraph",
    "uml",
    "visualization",
    "plantuml",
    "mermaid",
    "drakoflow",
    "c4-model",
    "graphviz"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:drakoflow"
  ],
  "contributes": {
    "languages": [
      {
        "id": "drakoflow",
        "aliases": [
          "DrakoFlow",
          "drakoflow"
        ],
        "extensions": [
          ".drako"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "drakoflow",
        "scopeName": "source.drako",
        "path": "./syntaxes/drakoflow.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "drakoflow.showPreview",
        "title": "DrakoFlow: Open Preview",
        "category": "DrakoFlow",
        "icon": "$(graph)"
      },
      {
        "command": "drakoflow.showPreviewToSide",
        "title": "DrakoFlow: Open Preview to the Side",
        "category": "DrakoFlow",
        "icon": "$(layout-centered-single)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "drakoflow.showPreviewToSide",
          "when": "resourceLangId == drakoflow",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "drakoflow.showPreview",
          "when": "resourceExtname == .drako"
        },
        {
          "command": "drakoflow.showPreviewToSide",
          "when": "resourceExtname == .drako"
        }
      ]
    },
    "configuration": {
      "title": "DrakoFlow",
      "properties": {
        "drakoflow.preview.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the DrakoFlow preview panel to the side when a .drako file is opened."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build-all",
    "build-all": "npm run compile && node scripts/copy-dist.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.4"
  }
}