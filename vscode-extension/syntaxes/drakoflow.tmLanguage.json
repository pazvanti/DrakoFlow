{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DrakoFlow",
  "scopeName": "source.drako",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#colors"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.drako",
          "match": "//.*$"
        },
        {
          "name": "comment.block.drako",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.tag.decorator.drako",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "entity.name.type.class.drako",
          "match": "\\b(Rectangle|Process|Ellipse|VerticalContainer|Cylinder|Cube|Diamond|Hexagon|Actor|Parallelogram|Class|Interface|UMLComponent|Module|Package|Text|Paragraph|SVGImage|RasterImage|Cloud|Node|Artifact|Folder|Frame|Storage|Stack|File|Card|Usecase|Boundary|Control|Entity|Queue|Collections|Agent|Enum|Abstract|Annotation|Struct|Object|Table|Branch|Commit|Chart|Bar|Line|Pie)\\b"
        },
        {
          "name": "keyword.other.direction.drako",
          "match": "\\b(LEFT|RIGHT|TOP|BOTTOM|left|right|top|bottom)\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.drako",
          "match": "\\b(label|icon|rx|ry|lifeline|url|lineWidth|shadow|themeOverride|lineStyle|color|thickness|routeType|startX|startY|animated|gap|padding|tabWidthRatio|radius|backgroundColor|borderColor|textColor|headerBackgroundColor|headerTextColor|headerType|headerTypeColor|headerTypeTextColor|colorizeHeaderByType|attributes|methods|items|align|text|content|scale|width|height|header|rows|headerAtTop|headerAtBottom|hash|tag|branch|order|msg|message|type|title|xLabel|yLabel|value|values|labels|colors|donut|doughnut|innerRadius|startAngle|showLabels|showPercentage|showPercentages|percentages|showValues|showLegend|legend|x|y|strokeWidth|grid|filled|fill|area|is3D|is3d|threeD|depth|fillOpacity)\\b"
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "name": "constant.other.color.hex.drako",
          "match": "#[0-9a-fA-F]{3,8}\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.drako",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.drako",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.drako",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.drako",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.relationship.drako",
          "match": "(<--|-->|->|<-|--|-o|o-|-\\*|\\*-|<->|<--|-->)"
        },
        {
          "name": "keyword.operator.accessor.drako",
          "match": "(^|\\s)[+\\-#~*](?=[a-zA-Z_])"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.constant.drako",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_.]*\\s*(?=:)"
        }
      ]
    }
  }
}
